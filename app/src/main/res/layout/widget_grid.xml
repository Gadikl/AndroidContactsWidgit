<?xml version="1.0" encoding="utf-8"?>
<!-- 3x3 grid. Each cell = photo (fills available space) + name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout style="@style/GridRow">
        <LinearLayout android:id="@+id/cell0" style="@style/GridCell">
            <ImageView android:id="@+id/img0" style="@style/GridPhoto" />
            <TextView android:id="@+id/name0" style="@style/GridName" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cell1" style="@style/GridCell">
            <ImageView android:id="@+id/img1" style="@style/GridPhoto" />
            <TextView android:id="@+id/name1" style="@style/GridName" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cell2" style="@style/GridCell">
            <ImageView android:id="@+id/img2" style="@style/GridPhoto" />
            <TextView android:id="@+id/name2" style="@style/GridName" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout style="@style/GridRow">
        <LinearLayout android:id="@+id/cell3" style="@style/GridCell">
            <ImageView android:id="@+id/img3" style="@style/GridPhoto" />
            <TextView android:id="@+id/name3" style="@style/GridName" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cell4" style="@style/GridCell">
            <ImageView android:id="@+id/img4" style="@style/GridPhoto" />
            <TextView android:id="@+id/name4" style="@style/GridName" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cell5" style="@style/GridCell">
            <ImageView android:id="@+id/img5" style="@style/GridPhoto" />
            <TextView android:id="@+id/name5" style="@style/GridName" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout style="@style/GridRow">
        <LinearLayout android:id="@+id/cell6" style="@style/GridCell">
            <ImageView android:id="@+id/img6" style="@style/GridPhoto" />
            <TextView android:id="@+id/name6" style="@style/GridName" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cell7" style="@style/GridCell">
            <ImageView android:id="@+id/img7" style="@style/GridPhoto" />
            <TextView android:id="@+id/name7" style="@style/GridName" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cell8" style="@style/GridCell">
            <ImageView android:id="@+id/img8" style="@style/GridPhoto" />
            <TextView android:id="@+id/name8" style="@style/GridName" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
